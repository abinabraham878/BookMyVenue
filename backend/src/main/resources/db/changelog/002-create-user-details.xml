<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-user-details" author="abin">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_details"/>
            </not>
        </preConditions>

        <createTable tableName="user_details">

            <column name="user_id" type="UUID">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_user_details"
                        nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="country_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="profile_image_url" type="VARCHAR(500)"/>

            <column name="created_at"
                    type="TIMESTAMPTZ"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="UUID"/>

            <column name="updated_at" type="TIMESTAMPTZ"/>

            <column name="updated_by" type="UUID"/>

            <column name="deleted_at" type="TIMESTAMPTZ"/>

            <column name="deleted_by" type="UUID"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="user_details"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_details_user_id"/>

        <addUniqueConstraint
                tableName="user_details"
                columnNames="country_code, phone_number"
                constraintName="uk_user_details_country_code_phone_number"/>

        <createIndex
                tableName="user_details"
                indexName="idx_user_details_deleted_at">
            <column name="deleted_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="user_details"/>
        </rollback>

    </changeSet>

</databaseChangeLog>